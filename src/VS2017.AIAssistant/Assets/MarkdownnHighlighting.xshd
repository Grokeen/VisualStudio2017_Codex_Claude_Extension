<?xml version="1.0" encoding="utf-8"?>
<!-- [기능 폴더] Features/Markdown
     [역할] 마크다운 편집기에 적용할 구문 색상 규칙을 정의합니다.
     [읽는 순서] 제목·목록·링크·인용·코드 규칙 → AvalonEdit
     [안내] 같은 폴더의 README.md에서 코드와 리소스 연결을 확인하세요. -->

<SyntaxDefinition name="Markdownn Dark" extensions=".md" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Heading" foreground="#82AAFF" fontWeight="bold" />
  <Color name="Marker" foreground="#94A3B8" />
  <Color name="Strong" foreground="#F9E2AF" fontWeight="bold" />
  <Color name="Emphasis" foreground="#C4B5FD" fontStyle="italic" />
  <Color name="Strike" foreground="#94A3B8" />
  <Color name="Code" foreground="#86EFAC" />
  <Color name="Link" foreground="#7DD3FC" />
  <Color name="Fence" foreground="#86EFAC" />
  <RuleSet>
    <Span color="Code" multiline="true">
      <Begin>^\s*```.*$</Begin>
      <End>^\s*```\s*$</End>
    </Span>
    <Span color="Code" multiline="true">
      <Begin>^\s*~~~.*$</Begin>
      <End>^\s*~~~\s*$</End>
    </Span>
    <Rule color="Heading">^\s{0,3}\#{1,6}\s.*$</Rule>
    <Rule color="Marker">^\s{0,3}&gt;\s?|^\s*([-*+]|\d+[.)])(?=\s)|\[[ xX]\](?=\s)</Rule>
    <Rule color="Link">!?\[[^\]]+\]\([^)]+\)|&lt;https?://[^&gt;]+&gt;</Rule>
    <Rule color="Code">`+[^`]+`+</Rule>
    <Rule color="Strong">\*\*[^*]+\*\*|__[^_]+__</Rule>
    <Rule color="Strike">~~[^~]+~~</Rule>
    <Rule color="Emphasis">\*[^*]+\*|_[^_]+_</Rule>
    <Rule color="Fence">^\s*[-*_]{3,}\s*$</Rule>
  </RuleSet>
</SyntaxDefinition>
