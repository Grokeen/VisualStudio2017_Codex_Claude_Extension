 <ContextMenu x:Key="AssistantTextContextMenu" Style="{StaticResource AssistantContextMenu}">
  <MenuItem Header="실행 취소" Icon="↶" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" Style="{StaticResource AssistantMenuItem}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
  <MenuItem Header="다시 실행" Icon="↷" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" Style="{StaticResource AssistantMenuItem}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
  <Separator Style="{StaticResource AssistantMenuSeparator}"/>
  <MenuItem Header="잘라내기" Icon="✂" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" Style="{StaticResource AssistantMenuItem}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
  <MenuItem Header="복사" Icon="▤" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" Style="{StaticResource AssistantMenuItem}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
  <MenuItem Header="붙여넣기" Icon="▣" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" Style="{StaticResource AssistantMenuItem}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
  <MenuItem Header="삭제" Icon="×" Command="ApplicationCommands.Delete" Style="{StaticResource AssistantMenuItem}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
  <Separator Style="{StaticResource AssistantMenuSeparator}"/>
  <MenuItem Header="모두 선택" Icon="☷" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" Style="{StaticResource AssistantMenuItem}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
