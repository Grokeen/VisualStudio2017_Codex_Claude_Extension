<UserControl x:Class="VS2017.AIAssistant.Views.AssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200" MinHeight="160">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="AI Assistant · 소스 수정" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Text="AI 선택" />
                <ComboBox x:Name="ProviderChoice" SelectedIndex="0" SelectedValuePath="Tag"
                          SelectionChanged="ProviderChanged" Margin="0,4,0,8">
                    <ComboBoxItem Content="Codex" Tag="Codex" /><ComboBoxItem Content="Claude Code" Tag="Claude" />
                </ComboBox>
                <TextBlock Text="CLI 실행 파일 (.exe, 비워두면 PATH 사용)" TextWrapping="Wrap" />
                <DockPanel Margin="0,4,0,0">
                    <Button x:Name="BrowseButton" Content="찾기…" DockPanel.Dock="Right" Click="BrowseClicked" Margin="6,0,0,0" Padding="8,3" />
                    <TextBox x:Name="ExecutablePath" VerticalContentAlignment="Center" />
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="현재 파일 수정 요청" />
                <TextBox x:Name="Instruction" Margin="0,4,0,0" MinHeight="70" MaxHeight="160"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="16000"
                         AutomationProperties.Name="현재 파일 수정 요청" />
                <TextBlock Margin="0,6,0,0" Text="현재 파일의 편집 내용을 선택한 AI에 보내 수정안을 만듭니다. 적용 전 변경 내용을 검토하세요."
                           TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                <Button x:Name="GenerateButton" Content="수정안 생성" Click="GenerateClicked" Padding="10,5" Margin="0,0,6,6" IsEnabled="False" />
                <Button x:Name="StopButton" Content="중지" Click="StopClicked" Padding="10,5" Margin="0,0,0,6" IsEnabled="False" />
            </WrapPanel>
            <StackPanel Grid.Row="4" Margin="0,4,0,8">
                <TextBlock x:Name="TargetLabel" Text="대상: 수정안 생성 시 활성 파일을 선택합니다." TextWrapping="Wrap" />
                <TextBlock x:Name="StatusLabel" Margin="0,6,0,0" Text="CLI를 설치하고 터미널에서 로그인한 뒤 소스 파일을 열어 주세요." TextWrapping="Wrap" />
            </StackPanel>
            <TabControl x:Name="ReviewTabs" Grid.Row="5" Height="260" MinWidth="0">
                <TabItem Header="변경 비교">
                    <TextBox x:Name="DiffPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                </TabItem>
                <TabItem Header="원본">
                    <TextBox x:Name="OriginalPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                </TabItem>
                <TabItem Header="수정안">
                    <TextBox x:Name="ProposedPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                </TabItem>
            </TabControl>
            <CheckBox x:Name="ReviewApproval" Grid.Row="6" Margin="0,10,0,0" Checked="ApprovalChanged" Unchecked="ApprovalChanged" IsEnabled="False">
                <TextBlock Text="비교한 변경을 현재 파일에 적용하는 데 동의합니다." TextWrapping="Wrap"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </CheckBox>
            <WrapPanel Grid.Row="7" Margin="0,8,0,0">
                <Button x:Name="ApplyButton" Content="승인 후 적용" Click="ApplyClicked" Padding="8,5" Margin="0,0,6,6" IsEnabled="False" />
                <Button x:Name="SaveButton" Content="적용 내용 저장" Click="SaveClicked" Padding="8,5" Margin="0,0,6,6" IsEnabled="False" />
                <Button x:Name="RestoreButton" Content="직전 적용 되돌리기" Click="RestoreClicked" Padding="8,5" Margin="0,0,0,6" IsEnabled="False" />
            </WrapPanel>
            <TextBlock Grid.Row="8" Margin="0,4,0,0" Text="적용은 편집기 내용을 변경합니다. 파일 저장은 별도이며, 편집기의 실행 취소(Ctrl+Z)도 사용할 수 있습니다." TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>
