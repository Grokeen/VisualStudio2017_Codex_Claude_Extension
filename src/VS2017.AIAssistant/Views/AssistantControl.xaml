<UserControl x:Class="VS2017.AIAssistant.Views.AssistantControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VS2017.AIAssistant.Views"
 MinWidth="200" MinHeight="300" FontSize="14" AllowDrop="True" PreviewDragOver="AttachmentsDragOver" PreviewDrop="AttachmentsDropped" SizeChanged="ChatSizeChanged">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AssistantTheme.xaml"/></ResourceDictionary.MergedDictionaries><local:MiddleTitleConverter x:Key="MiddleTitle"/></ResourceDictionary></UserControl.Resources>
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="LayoutRoot" Margin="10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <TabControl x:Name="ProviderChoice" FontSize="13" Padding="0" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="ProviderChanged" BorderThickness="0" Background="Transparent">
     <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="B" Background="Transparent" Padding="2,7" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#CBCBCB"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.ItemContainerStyle>
     <TabItem Tag="Claude"><TabItem.Header><StackPanel Orientation="Horizontal"><Image x:Name="ClaudeTabLogo" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="Claude"/></StackPanel></TabItem.Header></TabItem>
     <TabItem Tag="Codex"><TabItem.Header><StackPanel Orientation="Horizontal"><Image x:Name="CodexTabLogo" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="Codex"/></StackPanel></TabItem.Header></TabItem>
    </TabControl>
    <ToggleButton x:Name="OptionsToggle" FontSize="14" Grid.Column="1" Content="☷" ToolTip="설정 및 사용 안내" AutomationProperties.Name="설정 및 사용 안내 메뉴" MouseEnter="OptionsHovered" Click="OptionsClicked" VerticalAlignment="Top" Margin="2"/>
   </Grid>
   <WrapPanel Grid.Row="1" Margin="0,8,0,6"><ToggleButton x:Name="HistoryToggle" Content="☰" ToolTip="대화 목록 보이기/숨기기" Click="HistoryToggled" Margin="0,0,5,4"/><Button x:Name="NewChatButton" Content="＋ 새 대화" Click="NewChatClicked" Margin="0,0,5,4"/><Button x:Name="LoadChatButton" Content="↥ 불러오기" Click="LoadChatClicked" Margin="0,0,0,4"/><TextBlock x:Name="ThinkingIndicator" Text="◌ 생각하는 중…" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,4"/></WrapPanel>
   <Expander x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" Header="⚙ 설정" Expanded="SettingsExpanded" Collapsed="PanelCollapsed" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}">
    <ScrollViewer x:Name="SettingsContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SettingsContentResized"><StackPanel Margin="2,0,2,6">
     <TextBlock x:Name="SettingsProviderLabel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <Button x:Name="CliHelpButton" Content="? CLI 설치·로그인 방법" Click="CliHelpClicked" Margin="0,0,0,10" HorizontalAlignment="Left"/>
     <TextBlock Text="CLI 실행 파일 (.exe, 비워두면 PATH 사용)" TextWrapping="Wrap"/><DockPanel Margin="0,4,0,6"><Button x:Name="BrowseButton" Content="… 찾기" DockPanel.Dock="Right" Click="BrowseClicked" Margin="6,0,0,0"/><TextBox x:Name="ExecutablePath" VerticalContentAlignment="Center"/></DockPanel>
     <WrapPanel><Button x:Name="LoginButton" Content="↗ 계정 연결" Click="LoginClicked" Margin="0,0,6,6"/><Button x:Name="AccountCheckButton" Content="✓ 연결 확인" Click="AccountCheckClicked" Margin="0,0,0,6"/></WrapPanel>
     <TextBlock x:Name="AccountLabel" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock Text="모델 (비워두면 CLI 기본값)"/><TextBox x:Name="ModelName" MaxLength="120" Margin="0,4,0,10" TextChanged="SettingsModelChanged"/>
     <TextBlock Text="instruction · 모든 프로젝트의 공통 Markdown 규칙" TextWrapping="Wrap"/>
     <TextBox x:Name="RulesText" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Height="150" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/>
     <TextBlock x:Name="RulesPathLabel" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,10"/>
     <WrapPanel><TextBlock Text="글자 크기" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="TextSizeChoice" Width="70" Margin="0,0,8,6" SelectionChanged="TextSizeChanged" SelectedValuePath="Content"><ComboBoxItem Content="10"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="28"/></ComboBox><Button x:Name="SaveSettingsButton" Content="✓ 설정 저장" Click="SaveSettingsClicked" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/></WrapPanel>
    </StackPanel></ScrollViewer>
   </Expander>
   <Grid x:Name="WorkspaceGrid" Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition x:Name="HistoryColumn" Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="HistoryPanel" Visibility="Collapsed" Background="#1E1E1E" BorderBrush="#383838" BorderThickness="0,0,1,0" Padding="4" Margin="0,0,8,0" Panel.ZIndex="2"><DockPanel><TextBlock DockPanel.Dock="Top" Text="대화 기록" FontWeight="SemiBold" Margin="3,5,3,8"/><ListBox x:Name="ConversationList" SelectionChanged="ConversationSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title, Converter={StaticResource MiddleTitle}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Image x:Name="BrandWatermark" Grid.RowSpan="3" Width="170" Height="170" Opacity="0.055" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <TextBlock x:Name="ConversationStartedLabel" HorizontalAlignment="Center" Foreground="#9A9A9A" FontSize="11" Margin="4,5,4,12" ToolTip="이 대화가 생성된 실제 시각"/>
     <TextBlock x:Name="ActivityLabel" Grid.Row="1" Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
     <ScrollViewer x:Name="ConversationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border x:Name="EmptyHint" BorderBrush="#373737" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,8"><StackPanel><TextBlock Text="무엇을 함께 만들까요?" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="소스를 선택하고 원하는 변경을 입력하세요. Enter 전송 · Ctrl+Enter 줄바꿈" TextWrapping="Wrap" Opacity="0.7" Margin="0,7,0,0"/></StackPanel></Border>
      <ItemsControl x:Name="ConversationMessages"><ItemsControl.ItemTemplate><DataTemplate><Border x:Name="MessageBubble" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,9"><StackPanel><TextBlock x:Name="MessageSpeaker" Text="{Binding Speaker}" Visibility="Collapsed" FontSize="11" Foreground="#A8A8A8" Margin="0,0,0,4"/><TextBox x:Name="MessageBody" Text="{Binding Text, Mode=OneWay}" Loaded="ChildLoaded" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0" Background="Transparent" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter TargetName="MessageBubble" Property="Background" Value="#303030"/><Setter TargetName="MessageBubble" Property="CornerRadius" Value="18"/><Setter TargetName="MessageBubble" Property="Padding" Value="13,10"/><Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="MessageBubble" Property="Margin" Value="24,8,0,12"/></DataTrigger><DataTrigger Binding="{Binding Role}" Value="system"><Setter TargetName="MessageSpeaker" Property="Visibility" Value="Visible"/><Setter TargetName="MessageBody" Property="Foreground" Value="#AAAAAA"/><Setter TargetName="MessageBody" Property="FontSize" Value="12"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
   <Border x:Name="ChangeCard" Grid.Row="4" BorderBrush="#424242" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,8"><StackPanel>
    <WrapPanel><TextBlock x:Name="ChangeSummary" Text="변경된 파일 0개" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,5"/><Button x:Name="RestoreButton" Content="↶ 되돌리기" Click="RestoreClicked" Padding="6,3" Margin="0,0,5,5" IsEnabled="False"/><Button x:Name="ViewChangesButton" Content="≡ 변경 보기" Click="ViewChangesClicked" Padding="6,3" Margin="0,0,0,5"/></WrapPanel>
    <Button x:Name="SourceLink" Style="{StaticResource LinkButton}" Click="SourceLinkClicked" HorizontalAlignment="Left" ToolTip="선택한 소스로 이동"><TextBlock x:Name="TargetLabel" Text="소스를 선택하면 변경 파일이 표시됩니다." TextTrimming="CharacterEllipsis" FontSize="12" TextDecorations="Underline"/></Button>
    <Expander x:Name="ReviewPanel" Header="변경 비교" Expanded="ReviewExpanded" Collapsed="PanelCollapsed" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"><ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TabControl x:Name="ReviewTabs" Height="175" Margin="0,6,0,0" Background="Transparent" ItemContainerStyle="{Binding ItemContainerStyle, ElementName=ProviderChoice}"><TabItem Header="변경 비교"><TextBox x:Name="DiffPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="원본"><TextBox x:Name="OriginalPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem><TabItem Header="수정안"><TextBox x:Name="ProposedPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem></TabControl>
     <CheckBox x:Name="ReviewApproval" Margin="0,8,0,0" Checked="ApprovalChanged" Unchecked="ApprovalChanged" IsEnabled="False"><TextBlock Text="비교한 변경을 현재 파일에 적용하는 데 동의합니다." TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/></CheckBox>
     <WrapPanel Margin="0,8,0,0"><Button x:Name="ApplyButton" Content="✓ 승인 후 적용" Click="ApplyClicked" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" IsEnabled="False"/><Button x:Name="SaveButton" Content="▣ 적용 내용 저장" Click="SaveClicked" Margin="0,0,0,6" IsEnabled="False"/></WrapPanel>
    </StackPanel></ScrollViewer></Expander>
   </StackPanel></Border>
   <Border Grid.Row="5" Background="#242424" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="16" Padding="9"><StackPanel>
    <ListBox x:Name="AttachmentList" MaxHeight="150" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border x:Name="AttachmentTile" BorderBrush="#535353" BorderThickness="1" CornerRadius="7" Margin="0,0,6,5" Padding="4" MaxWidth="138"><Grid>
     <StackPanel><Image Source="{Binding Thumbnail}" Width="112" Height="82" Stretch="Uniform"/><TextBlock Text="{Binding Label}" MaxWidth="120" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding Label}"/></StackPanel>
     <Button x:Name="RemoveAttachmentButton" Content="×" Tag="{Binding}" Click="RemoveAttachmentClicked" Padding="4,0" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" ToolTip="첨부 제거" AutomationProperties.Name="첨부 제거"/>
    </Grid></Border><DataTemplate.Triggers><Trigger SourceName="AttachmentTile" Property="IsMouseOver" Value="True"><Setter TargetName="RemoveAttachmentButton" Property="Opacity" Value="1"/></Trigger><Trigger SourceName="RemoveAttachmentButton" Property="IsKeyboardFocused" Value="True"><Setter TargetName="RemoveAttachmentButton" Property="Opacity" Value="1"/></Trigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Grid><TextBox x:Name="Instruction" MinHeight="65" MaxHeight="150" MaxLength="16000" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" PreviewKeyDown="PromptKeyDown" AutomationProperties.Name="AI 요청 · Enter 전송, Ctrl+Enter 줄바꿈"/><TextBlock Text="원하는 변경을 입력하세요" Margin="6,6" Opacity="0.45" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Instruction}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <WrapPanel Margin="0,7,0,0"><Button x:Name="AttachButton" Content="＋" Click="AttachClicked" ToolTip="이미지·텍스트 첨부" AutomationProperties.Name="첨부" Padding="7,4" Margin="0,0,5,5"/><Button x:Name="PermissionsButton" Content="⚿" Click="PermissionsClicked" ToolTip="DB·형상관리·배포 권한 및 작업" AutomationProperties.Name="작업 권한" Padding="7,4" Margin="0,0,5,5"/><ComboBox x:Name="RequestModel" IsEditable="True" IsTextSearchEnabled="False" Width="130" ToolTip="상세 AI 모델 · 비워두면 CLI 기본" Margin="0,0,5,5"/><ComboBox x:Name="ModeChoice" Width="87" SelectedValuePath="Tag" SelectionChanged="ModeChanged" ToolTip="생각 모드" Margin="0,0,5,5"><ComboBoxItem Content="자동" Tag="auto"/><ComboBoxItem Content="빠르게" Tag="low"/><ComboBoxItem Content="균형" Tag="medium"/><ComboBoxItem Content="깊게" Tag="high"/></ComboBox><Button x:Name="GenerateButton" Content="↑" Click="GenerateClicked" Style="{StaticResource PrimaryButton}" ToolTip="보내기 (Enter)" AutomationProperties.Name="보내기" Padding="9,4" Margin="0,0,5,5" IsEnabled="False"/><Button x:Name="StopButton" Content="■" Click="StopClicked" ToolTip="요청 중지" AutomationProperties.Name="중지" Padding="7,4" Margin="0,0,0,5" IsEnabled="False"/><Button x:Name="PasteButton" Content="붙여넣기" Click="PasteClicked" Visibility="Collapsed"/></WrapPanel>
   </StackPanel></Border>
  </Grid></ScrollViewer>
  <Canvas x:Name="FanPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="190" Height="118" Visibility="Collapsed" Panel.ZIndex="10" MouseLeave="OptionsMouseLeft"><Border Canvas.Top="32" Canvas.Left="0" Width="190" Height="86" Background="Transparent"/><Button x:Name="SettingsButton" Canvas.Top="37" Canvas.Left="77" Content="⚙ 설정" Click="SettingsClicked" ToolTip="계정·규칙·글자 크기"/><Button x:Name="HelpButton" Canvas.Top="76" Canvas.Left="5" Content="? 사용 안내" Click="HelpClicked"/></Canvas>
  <Border x:Name="ToastHost" Panel.ZIndex="20" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#EB333333" BorderBrush="#6B6B6B" BorderThickness="1" CornerRadius="12" Padding="15" Margin="15" MaxWidth="480"><TextBlock x:Name="StatusLabel" Text="파일을 열고 요청하세요. Enter 전송 · Ctrl+Enter 줄바꿈" TextWrapping="Wrap" Foreground="#F2F2F2"/></Border>
 </Grid>
</UserControl>
