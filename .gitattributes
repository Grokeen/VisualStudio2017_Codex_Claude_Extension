# Keep published binaries byte-for-byte intact on Windows checkouts.
*.pdf binary
*.zip binary
*.vsix binary
*.exe binary
*.png binary
*.gif binary
# These original guide assets are also packaged and checked by their raw bytes.
/InstallCLI.bat -text
/InstallAIAssistant.bat -text whitespace=cr-at-eol
/InstallOfflineCLI.bat -text whitespace=cr-at-eol
/PrepareOfflineSetup.bat -text whitespace=cr-at-eol
/VerifyOfflineSetup.bat -text whitespace=cr-at-eol
/HowToInstallCLI.md -text
# The pinned theme baseline and release checksums depend on exact file bytes.
/themes/VisualStudio/Baselines/*.xml -text
/releases/v0.12.0/* -text whitespace=cr-at-eol
